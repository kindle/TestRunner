<Window x:Class="TestViewer.Views.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Bailin Studio" 
        Height="360" 
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/SystemColors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource MainMenuBackgroundBrushKey}">
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Margin="0,100,0,20">
                Author: Bailin Wei
                Version: <TextBlock x:Name="Version"></TextBlock>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center">
                Please send feedback to v-bawei@microsoft.com, thanks!
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
