<Window x:Class="TestViewer.Views.NewTestPass"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TestViewer.Views"
        xmlns:vm="clr-namespace:TestViewer.ViewModels"
        Title="New Test Pass" 
        Height="500" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/SystemColors.xaml"/>
                <ResourceDictionary Source="/Resources/RoutedUICommands.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource ExitCommand}" CanExecute="CanExitExecute" Executed="ExitExecute"></CommandBinding>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Gesture="ESC" Command="{StaticResource ExitCommand}"></KeyBinding>
    </Window.InputBindings>
    <Window.DataContext>
        <vm:TestPassTemplatesViewModel x:Name="testPassTemplatesViewModel"></vm:TestPassTemplatesViewModel>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="130"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="{StaticResource TestPassTemplateTreeBackgroundBrushKey}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="5" Foreground="White" FontWeight="Bold">Installed Templates</TextBlock>
                <TreeView Grid.Row="1">
                    <TreeViewItem Header="All Templates" IsExpanded="True" Padding="3">
                        <TreeViewItem Header="Windows" Padding="3"></TreeViewItem>
                        <TreeViewItem Header="Web" Padding="3"></TreeViewItem>
                    </TreeViewItem>
                </TreeView>
            </Grid>
            <ListBox Grid.Column="1" ItemsSource="{Binding testPassTemplatesViewModel}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="50"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Resources/Zune.png" Height="40"></Image>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}"></TextBlock>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Type}"></TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Column="2"></TextBlock>
        </Grid>
        <Grid Grid.Row="1" Background="#BCC7D8" ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="4*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,3,3,3" VerticalAlignment="Center">Name:</TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1" Height="20" x:Name="testPassName" Margin="3">TestPass1</TextBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="10,3,3,3" VerticalAlignment="Center">Location:</TextBlock>
            <v:FolderBrowserBox  Grid.Row="1" Grid.Column="1" x:Name="testPassLocation" Height="20" Margin="3"></v:FolderBrowserBox>
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="10,3,3,3" VerticalAlignment="Center">Source:</TextBlock>
            <v:FileInputBox  Grid.Row="2" Grid.Column="1" x:Name="testPassSource" Height="20" Margin="3"></v:FileInputBox>
        </Grid>
        <Grid Grid.Row="2" Background="#475B7e" ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" HorizontalAlignment="Right" Width="80" Margin="5" Click="OKButtonClick">OK</Button>
            <Button Grid.Column="1" HorizontalAlignment="Left" Width="80" Margin="5" Command="{StaticResource ExitCommand}">Cancel</Button>
        </Grid>
    </Grid>
</Window>
